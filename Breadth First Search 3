

#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include <queue>
using namespace std;

int main() {
    int n;
    cin >> n;

    int a[n][n];
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            cin >> a[i][j];
        }
    }

    bool visited[n] = {false};
    int rslt[n];  
    int m = 0;

    queue<int> q;
    q.push(0);
    visited[0] = true;

    while (!q.empty()) {
        int node = q.front();
        q.pop();
     rslt[m++] = node;

        for (int i = 0; i < n; i++) {
            if (a[node][i] == 1 && !visited[i]) {
                q.push(i);
                visited[i] = true;
            }
        }
    }

    for (int i = 0; i < m; i++) {
        cout << rslt[i];
        if (i != m - 1) cout << " ";
    }
    return 0;
}
